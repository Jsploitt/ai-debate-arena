{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run build:*)",
      "Bash(bun run format:*)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx prettier --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(docker compose ps:*)"
    ]
  }
}
